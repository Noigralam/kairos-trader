# Binance API keys (required for live mode, leave empty for simulation)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Discord webhook URL for trade alerts (optional)
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ── Spot ──────────────────────────────────────────────────────────────────────

# Bot mode: simulation or live
MODE=live

# Trading pairs (comma-separated Binance EUR spot pairs)
TRADING_PAIRS=ETHEUR,SOLEUR,ADAEUR

# Simulation starting balance in EUR
SIMULATION_BALANCE=200.0

# Fraction of balance to allocate per trade
POSITION_SIZE_PCT=0.75

# DCA: average down when position drops this much from entry
DCA_DROP_PCT=0.01
DCA_SIZE_PCT=0.75

# Take-profit, trailing stop, profit floor
TAKE_PROFIT_PCT=0.05
TRAILING_STOP_PCT=0.05
PROFIT_FLOOR_PCT=0.03

# EMA gap filter: price must be this % above EMA200 before a buy signal fires
EMA_GAP_PCT=0.02
# Disable per pair if it frequently trades below EMA200:
# EMA_GAP_PCT_ADAEUR=0

# Time-based stop: close position if profit floor not reached within N days (0 = disabled)
TIME_STOP_DAYS=0

# Max portfolio drawdown: pause new buys if portfolio drops >X% from peak (0 = disabled)
MAX_DRAWDOWN_PCT=0

# Minimum profit before a sell signal can close a position
MIN_EXIT_PROFIT_PCT=0.02
# Per-pair override example:
# MIN_EXIT_PROFIT_PCT_SOLEUR=0.03

# RSI settings
RSI_PERIOD=14
RSI_PERIOD_ETHEUR=7
RSI_PERIOD_SOLEUR=7
RSI_PERIOD_ADAEUR=5
RSI_OVERSOLD=30
RSI_OVERSOLD_ADAEUR=33
RSI_OVERBOUGHT=75
RSI_OVERBOUGHT_ETHEUR=65
RSI_OVERBOUGHT_SOLEUR=80

# Candle interval: 1m 5m 15m 30m 1h 4h 1d
INTERVAL=15m

# Between-candle stop check interval in seconds
SPOT_STOP_CHECK_INTERVAL=60

# ── Futures ───────────────────────────────────────────────────────────────────

FUTURES_ENABLED=true

# Mode: simulation or live
FUTURES_MODE=simulation

# USDT-M perpetual pairs
FUTURES_TRADING_PAIRS=ETHUSDT,SOLUSDT

# Leverage and margin type
FUTURES_LEVERAGE=2
FUTURES_MARGIN_TYPE=ISOLATED

# Fraction of balance to use as margin per trade
FUTURES_POSITION_SIZE_PCT=0.50

# DCA: average down when position drops this much from entry (0.99 = effectively disabled)
FUTURES_DCA_DROP_PCT=0.99
FUTURES_DCA_SIZE_PCT=0.75

# Take-profit, trailing stop, profit floor
FUTURES_TAKE_PROFIT_PCT=0.05
FUTURES_TRAILING_STOP_PCT=0.05
FUTURES_PROFIT_FLOOR_PCT=0.01

# Minimum profit before a signal sell can fire
FUTURES_MIN_EXIT_PROFIT_PCT=0.02

# Max portfolio drawdown guard (0 = disabled)
FUTURES_MAX_DRAWDOWN_PCT=0

# RSI settings
# Note: RSI<25 significantly outperforms RSI<35 over 2yr backtest —
# extreme entries recover fast with minimal funding cost and zero liquidations
FUTURES_RSI_PERIOD=7
FUTURES_RSI_OVERSOLD=25
FUTURES_RSI_OVERBOUGHT=75

# EMA gap filter
FUTURES_EMA_GAP_PCT=0.02

# Between-candle stop check interval in seconds
FUTURES_STOP_CHECK_INTERVAL=60

# ── Web dashboard ─────────────────────────────────────────────────────────────

WEB_HOST=0.0.0.0
WEB_PORT=8888
