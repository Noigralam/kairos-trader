# ── Credentials ───────────────────────────────────────────────────────────────
BINANCE_API_KEY=                   # required for live mode
BINANCE_SECRET_KEY=
DISCORD_WEBHOOK_URL=               # webhook for trade alerts (optional)
DISCORD_BOT_TOKEN=                 # enables slash commands (optional)
DISCORD_GUILD_ID=                  # guild ID for instant slash command registration (optional)

# ── Web dashboard ─────────────────────────────────────────────────────────────
WEB_HOST=0.0.0.0                   # 0.0.0.0 = accessible on LAN
WEB_PORT=8888

# ── Spot ──────────────────────────────────────────────────────────────────────
SPOT_MODE=simulation               # simulation | live
SPOT_TRADING_PAIRS=ETHEUR,SOLEUR   # comma-separated Binance EUR pairs; order sets DCA priority
SPOT_INVESTED=0                    # total EUR deposited; dashboard "from X€" reference (0 = first recorded balance)
SPOT_SIMULATION_BALANCE=200.0      # virtual EUR balance (simulation only)
SPOT_FEE=0.001                     # 0.1% Binance maker/taker rate

SPOT_INTERVAL=15m                  # candle interval: 1m 5m 15m 30m 1h 4h 1d
SPOT_POSITION_SIZE_PCT=0.75        # fraction of balance spent per new position

# DCA — averages down as price falls from entry
SPOT_DCA_MAX=3                     # max tranches (0 = disabled, goes all-in on entry)
SPOT_DCA_DROP_PCT=0.01             # drop from entry that triggers first tranche
SPOT_DCA_STEP_PCT=0.01             # additional drop per subsequent tranche (2nd @ -2%, 3rd @ -3%)
SPOT_DCA_SIZE_PCT=0.75             # fraction of remaining balance per tranche (last tranche uses 100%)

# Exit parameters
SPOT_TAKE_PROFIT_PCT=0.05          # hard take-profit above entry
SPOT_TRAILING_STOP_PCT=0.025       # trailing stop drop from peak (only fires above profit floor)
SPOT_PROFIT_FLOOR_PCT=0.015        # minimum profit required before trailing stop can fire
SPOT_MIN_EXIT_PROFIT_PCT=0.02      # minimum profit before RSI sell signal can close position

# Partial close — sell a fraction at TP, trail the rest with a tighter stop
SPOT_PARTIAL_CLOSE_PCT=0           # fraction to sell at take-profit (0 = disabled)
SPOT_PARTIAL_CLOSE_TRAIL_PCT=0.02  # trailing stop on the remainder after partial close

# Entry filters
SPOT_RSI_PERIOD=14                 # RSI lookback period (global default; per-pair overrides common)
SPOT_RSI_OVERSOLD=30               # buy when RSI drops below this
SPOT_RSI_OVERBOUGHT=75             # sell when RSI rises above this
SPOT_EMA_GAP_PCT=0                 # price must be this % above EMA200 to allow a buy (0 = no gap filter)
SPOT_DAILY_EMA_FILTER=false        # also require price > daily EMA200

# Risk controls
SPOT_TIME_STOP_DAYS=0              # close stalled positions after N days (0 = disabled)
SPOT_MAX_DRAWDOWN_PCT=0            # pause buys if portfolio drops >X% from peak (0 = disabled)
SPOT_STOP_CHECK_INTERVAL=30        # seconds between between-candle stop checks

# Re-entry gates — applied after a trailing stop fires
SPOT_STOP_COOLDOWN_CANDLES=0       # block re-entry for N candles (0 = disabled)
SPOT_REENTRY_DROP_PCT=0            # require price to drop X% from stop price before re-entry (0 = disabled)

# Volume filter — require above-average volume on the entry candle
SPOT_VOLUME_FILTER_PERIOD=0        # rolling mean period (0 = disabled)
SPOT_VOLUME_FILTER_MULT=1.5        # volume must exceed this multiple of the rolling mean

# Per-pair overrides — append _{PAIR} to any setting above, e.g.:
# SPOT_RSI_PERIOD_SOLEUR=7
# SPOT_RSI_OVERBOUGHT_SOLEUR=80
# SPOT_RSI_PERIOD_ETHEUR=7
# SPOT_RSI_OVERBOUGHT_ETHEUR=65
# SPOT_MIN_EXIT_PROFIT_PCT_SOLEUR=0.01

# ── Spot shadow simulations ───────────────────────────────────────────────────
# Paper-trade alternative strategies alongside the live bot using the same candle feed.
# Each shadow has its own virtual balance and state file. Only overridden params needed.
#
# SPOT_SHADOW_PROFILES=FAST,CONSERVATIVE   # comma-separated profile names
#
# SPOT_SHADOW_FAST_PAIRS=SOLEUR            # pairs to trade (defaults to SPOT_TRADING_PAIRS)
# SPOT_SHADOW_FAST_INTERVAL=15m            # candle interval (defaults to SPOT_INTERVAL)
# SPOT_SHADOW_FAST_BALANCE=200             # starting virtual balance (EUR)
# SPOT_SHADOW_FAST_RSI_PERIOD=7
# SPOT_SHADOW_FAST_RSI_OVERSOLD=25
# SPOT_SHADOW_FAST_RSI_OVERBOUGHT=70
# SPOT_SHADOW_FAST_EMA_GAP_PCT=0
# SPOT_SHADOW_FAST_TAKE_PROFIT_PCT=0.03
# SPOT_SHADOW_FAST_TRAILING_STOP_PCT=0.02
# SPOT_SHADOW_FAST_PROFIT_FLOOR_PCT=0.01
# SPOT_SHADOW_FAST_MIN_EXIT_PROFIT_PCT=0.01
# SPOT_SHADOW_FAST_DCA_MAX=0
# SPOT_SHADOW_FAST_DCA_DROP_PCT=0.01
# SPOT_SHADOW_FAST_DCA_STEP_PCT=0.01
# SPOT_SHADOW_FAST_DCA_SIZE_PCT=0.75
# SPOT_SHADOW_FAST_POSITION_SIZE_PCT=0.75
# SPOT_SHADOW_FAST_TIME_STOP_DAYS=0
# SPOT_SHADOW_FAST_STOP_COOLDOWN_CANDLES=0
# SPOT_SHADOW_FAST_REENTRY_DROP_PCT=0
# SPOT_SHADOW_FAST_PARTIAL_CLOSE_PCT=0
# SPOT_SHADOW_FAST_PARTIAL_CLOSE_TRAIL_PCT=0.02
# SPOT_SHADOW_FAST_VOLUME_FILTER_PERIOD=0
# SPOT_SHADOW_FAST_VOLUME_FILTER_MULT=1.5
# SPOT_SHADOW_FAST_TYPE=grid               # grid strategy instead of RSI (also set LEVELS and SPACING)

# ── Futures ───────────────────────────────────────────────────────────────────
FUTURES_ENABLED=false              # set to true to enable the futures engine
FUTURES_MODE=simulation            # simulation | live
FUTURES_TRADING_PAIRS=ETHUSDT,SOLUSDT
FUTURES_SIMULATION_BALANCE=200.0   # virtual USDT balance (simulation only)

FUTURES_LEVERAGE=2                 # notional = margin × leverage
FUTURES_MARGIN_TYPE=ISOLATED       # ISOLATED = loss capped per position | CROSSED = shared collateral
FUTURES_FEE=0.0005                 # 0.05% taker; funding cost adds on top for open longs
FUTURES_POSITION_SIZE_PCT=1.0      # fraction of balance posted as margin per position

# DCA
FUTURES_DCA_DROP_PCT=0.99          # drop from entry to trigger DCA (0.99 = effectively disabled)
FUTURES_DCA_SIZE_PCT=0.75          # fraction of remaining balance for DCA tranche

# Exit parameters
FUTURES_TAKE_PROFIT_PCT=0.05       # hard take-profit above entry (on notional)
FUTURES_TRAILING_STOP_PCT=0.05     # trailing stop drop from peak
FUTURES_PROFIT_FLOOR_PCT=0.01      # minimum profit before trailing stop can fire
FUTURES_MIN_EXIT_PROFIT_PCT=0.02   # minimum profit before signal exit can fire

# Entry filters
FUTURES_RSI_PERIOD=7               # RSI lookback
FUTURES_RSI_OVERSOLD=25            # buy when RSI drops below this
FUTURES_RSI_OVERBOUGHT=75          # logged for reference; exits handled by trailing stop, not RSI
FUTURES_EMA_GAP_PCT=0.02           # price must be this % above EMA200 to allow a long entry
FUTURES_MAX_FUNDING_RATE=0.0005    # skip entry when 8h funding rate exceeds this (0 = disabled)

# Risk controls
FUTURES_MAX_DRAWDOWN_PCT=0         # pause longs if portfolio drops >X% from peak (0 = disabled)
FUTURES_STOP_CHECK_INTERVAL=30     # seconds between between-candle stop/funding checks

# Per-pair overrides — append _{SYMBOL} to any setting above, e.g.:
# FUTURES_RSI_PERIOD_ETHUSDT=7
# FUTURES_RSI_OVERSOLD_SOLUSDT=30

# ── Futures shadow simulations ────────────────────────────────────────────────
# Same concept as spot shadows but for the futures engine.
#
# FUTURES_SHADOW_PROFILES=LEV1X,NO_EMA
#
# FUTURES_SHADOW_LEV1X_SYMBOLS=ETHUSDT     # symbols to trade (defaults to FUTURES_TRADING_PAIRS)
# FUTURES_SHADOW_LEV1X_BALANCE=200
# FUTURES_SHADOW_LEV1X_LEVERAGE=1
# FUTURES_SHADOW_LEV1X_RSI_PERIOD=7
# FUTURES_SHADOW_LEV1X_RSI_OVERSOLD=25
# FUTURES_SHADOW_LEV1X_EMA_GAP_PCT=0.02
# FUTURES_SHADOW_LEV1X_MAX_FUNDING_RATE=0.0005
