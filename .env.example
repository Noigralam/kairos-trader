# Binance API keys (required for live mode, leave empty for simulation)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Discord webhook URL for trade alerts (optional)
DISCORD_WEBHOOK_URL=

# Discord bot token for slash commands (optional — see README for setup)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Bot mode: simulation or live
MODE=simulation

# Trading pairs (comma-separated Binance EUR spot pairs)
TRADING_PAIRS=ETHEUR,SOLEUR

# Simulation starting balance in EUR
SIMULATION_BALANCE=200.0

# Fraction of balance to allocate per trade
POSITION_SIZE_PCT=0.75

# DCA: average down when position drops this much from entry
DCA_DROP_PCT=0.01
DCA_SIZE_PCT=0.75

# Take-profit and trailing stop
TAKE_PROFIT_PCT=0.05
TRAILING_STOP_PCT=0.05

# Minimum profit before a sell signal can close a position (per-pair overrides supported)
MIN_EXIT_PROFIT_PCT=0.02
# MIN_EXIT_PROFIT_PCT_SOLEUR=0.03

# Minimum profit before trailing stop can fire
PROFIT_FLOOR_PCT=0.03

# EMA gap filter: price must be this % above EMA200 before a buy signal fires
EMA_GAP_PCT=0.02

# Daily EMA200 filter: also require price > EMA200 on 1d candles (sustained trend guard)
DAILY_EMA_FILTER=false

# Time-based stop: close position if it hasn't reached profit floor within N days (0 = disabled)
TIME_STOP_DAYS=0

# Max portfolio drawdown: pause new buys if portfolio drops >X% from peak (0 = disabled)
MAX_DRAWDOWN_PCT=0

# RSI settings (per-pair overrides: RSI_PERIOD_X, RSI_OVERSOLD_X, RSI_OVERBOUGHT_X)
RSI_PERIOD=14
RSI_PERIOD_ETHEUR=7
RSI_OVERSOLD=30
# RSI_OVERSOLD_ADAEUR=33
RSI_OVERBOUGHT=75
RSI_OVERBOUGHT_ETHEUR=65

# EMA gap filter override per pair (e.g. disable for pairs that trade below EMA200 frequently)
# EMA_GAP_PCT_ADAEUR=0

# Candle interval: 1m 5m 15m 30m 1h 4h 1d
INTERVAL=15m

# Web dashboard
WEB_HOST=0.0.0.0
WEB_PORT=8888
