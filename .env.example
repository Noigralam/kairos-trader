# ── Credentials ───────────────────────────────────────────────────────────────

# Binance API key and secret — required for live mode, leave empty for simulation
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Discord webhook posts trade alerts to a channel; bot token + guild ID enable
# the slash-command bot (/status, /close, /buy). All three are optional.
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ── Spot ──────────────────────────────────────────────────────────────────────

# simulation: uses a virtual balance, no real orders placed
# live: connects to Binance and places real EUR spot orders
SPOT_MODE=live

# Comma-separated Binance EUR spot pairs to trade
SPOT_TRADING_PAIRS=ETHEUR,SOLEUR,ADAEUR

# Virtual starting balance used in simulation mode (EUR)
SPOT_SIMULATION_BALANCE=200.0

# Binance maker/taker fee rate — 0.001 = 0.1% (standard; lower with BNB discount)
SPOT_FEE=0.001

# Candle interval for signal computation: 1m 5m 15m 30m 1h 4h 1d
SPOT_INTERVAL=15m

# Fraction of available EUR balance to spend on each new position (0.75 = 75%)
SPOT_POSITION_SIZE_PCT=0.75

# DCA (dollar-cost average): if price drops this % below entry, buy a second tranche
SPOT_DCA_DROP_PCT=0.01
# Fraction of remaining balance to use for the DCA tranche
SPOT_DCA_SIZE_PCT=0.75

# Hard take-profit: close immediately when price rises this % above entry
SPOT_TAKE_PROFIT_PCT=0.05

# Trailing stop: close when price falls this % below its peak (only fires above profit floor)
SPOT_TRAILING_STOP_PCT=0.05

# Profit floor: trailing stop won't fire unless position is at least this % in profit
# Prevents the trailing stop from closing at a loss during normal volatility
SPOT_PROFIT_FLOOR_PCT=0.03

# Minimum profit required before an RSI sell signal can close a position
# Stops the bot from exiting a position that hasn't recovered its entry fees yet
SPOT_MIN_EXIT_PROFIT_PCT=0.02
# Per-pair override (uncomment and adjust):
# SPOT_MIN_EXIT_PROFIT_PCT_SOLEUR=0.03

# RSI period — shorter = more sensitive, more signals; longer = smoother, fewer signals
SPOT_RSI_PERIOD=14
# Per-pair overrides (shorter periods suit faster-moving coins):
SPOT_RSI_PERIOD_ETHEUR=7
SPOT_RSI_PERIOD_SOLEUR=7
SPOT_RSI_PERIOD_ADAEUR=5

# RSI buy threshold — buy when RSI drops below this (oversold)
SPOT_RSI_OVERSOLD=30
# Per-pair override (higher value = more aggressive buying for volatile pairs):
SPOT_RSI_OVERSOLD_ADAEUR=33

# RSI sell threshold — close position when RSI rises above this (overbought / recovery complete)
SPOT_RSI_OVERBOUGHT=75
# Per-pair overrides:
SPOT_RSI_OVERBOUGHT_ETHEUR=65
SPOT_RSI_OVERBOUGHT_SOLEUR=80

# EMA gap filter: price must be this % above EMA200 to allow a buy — avoids buying in downtrends
SPOT_EMA_GAP_PCT=0.02
# Set to 0 per pair to disable the filter for coins that frequently dip below EMA200:
SPOT_EMA_GAP_PCT_ADAEUR=0

# Daily EMA200 filter: also require price to be above the daily EMA200 (stronger trend guard)
# false = use only the 15m EMA200; true = both timeframes must agree
SPOT_DAILY_EMA_FILTER=false

# Time-based stop: close a position that hasn't reached the profit floor within N days
# Prevents tying up capital in stalled positions indefinitely. 0 = disabled
SPOT_TIME_STOP_DAYS=0

# Portfolio drawdown guard: pause new buys if total portfolio value drops >X% from its peak
# Protects against buying into a sustained market-wide crash. 0 = disabled
SPOT_MAX_DRAWDOWN_PCT=0

# How often the between-candle stop-check thread runs (seconds)
# Checks trailing stop and take-profit between candle closes so exits aren't delayed by up to INTERVAL
SPOT_STOP_CHECK_INTERVAL=60

# ── Futures ───────────────────────────────────────────────────────────────────

# Set to false to disable the futures engine entirely
FUTURES_ENABLED=true

# simulation: virtual USDT balance, no real orders
# live: places real Binance USDT-M perpetual orders
FUTURES_MODE=simulation

# Comma-separated Binance USDT-M perpetual pairs to trade
FUTURES_TRADING_PAIRS=ETHUSDT,SOLUSDT

# Virtual starting balance used in futures simulation mode (USDT)
FUTURES_SIMULATION_BALANCE=200.0

# Leverage multiplier — notional = margin × leverage; higher leverage = larger position but closer liquidation
FUTURES_LEVERAGE=2

# ISOLATED: each position's loss is capped at its own margin
# CROSSED: all positions share the account balance as collateral (higher liquidation risk)
FUTURES_MARGIN_TYPE=ISOLATED

# Binance futures taker fee rate — 0.0005 = 0.05% (funding cost adds on top for open longs)
FUTURES_FEE=0.0005

# Fraction of available USDT balance to post as margin per new position
FUTURES_POSITION_SIZE_PCT=0.50

# DCA: average down when position drops this % below entry (0.99 = effectively disabled)
FUTURES_DCA_DROP_PCT=0.99
# Fraction of remaining balance to use for the DCA tranche
FUTURES_DCA_SIZE_PCT=0.75

# Hard take-profit: close when price rises this % above entry (measured on notional, not margin)
FUTURES_TAKE_PROFIT_PCT=0.05

# Trailing stop: close when price falls this % below its peak (only fires above profit floor)
FUTURES_TRAILING_STOP_PCT=0.05

# Profit floor: trailing stop won't fire unless position is at least this % in profit
# Lower than spot because leverage amplifies gains — 1% notional = 2% on margin at 2x
FUTURES_PROFIT_FLOOR_PCT=0.01

# Minimum profit (on notional) before an exit can be triggered by signal
FUTURES_MIN_EXIT_PROFIT_PCT=0.02

# RSI period for futures signal computation
FUTURES_RSI_PERIOD=7

# RSI buy threshold — RSI<25 significantly outperforms RSI<35 over 2yr backtest:
# extreme oversold entries recover fast, keeping positions open shorter and reducing funding cost
FUTURES_RSI_OVERSOLD=25

# RSI overbought — not used for exits (trailing stop handles that), but logged for reference
FUTURES_RSI_OVERBOUGHT=75

# EMA gap filter: price must be this % above EMA200 to allow a long entry
FUTURES_EMA_GAP_PCT=0.02

# Portfolio drawdown guard: pause new longs if portfolio drops >X% from peak. 0 = disabled
FUTURES_MAX_DRAWDOWN_PCT=0

# How often the between-candle stop-check thread runs (seconds)
# Also applies funding charges between candles so PnL stays accurate
FUTURES_STOP_CHECK_INTERVAL=60

# ── Web dashboard ─────────────────────────────────────────────────────────────

# Interface to bind on — 0.0.0.0 listens on all interfaces (LAN accessible)
WEB_HOST=0.0.0.0
# Port the web dashboard serves on
WEB_PORT=8888
