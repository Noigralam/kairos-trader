# ── Credentials ───────────────────────────────────────────────────────────────
BINANCE_API_KEY=                   # required for live mode
BINANCE_SECRET_KEY=
DISCORD_WEBHOOK_URL=               # webhook for trade alerts (optional)
DISCORD_BOT_TOKEN=                 # enables /status /close /buy slash commands (optional)
DISCORD_GUILD_ID=

# ── Spot ──────────────────────────────────────────────────────────────────────
SPOT_INVESTED=0                    # total EUR deposited to Binance; used as the 'from' reference on the dashboard (0 = use first recorded balance)
SPOT_MODE=live                     # simulation | live
SPOT_TRADING_PAIRS=ETHEUR,SOLEUR,ADAEUR
SPOT_SIMULATION_BALANCE=200.0      # virtual EUR balance (simulation only)
SPOT_FEE=0.001                     # 0.1% Binance maker/taker rate
SPOT_INTERVAL=15m                  # candle interval: 1m 5m 15m 30m 1h 4h 1d
SPOT_POSITION_SIZE_PCT=0.75        # fraction of balance spent per new position
SPOT_DCA_MAX=3                     # max number of DCA tranches per position
SPOT_DCA_DROP_PCT=0.01             # price drop from entry that triggers first DCA
SPOT_DCA_STEP_PCT=0.01             # additional drop required per subsequent tranche (2nd @ -2%, 3rd @ -3%)
SPOT_DCA_SIZE_PCT=0.75             # fraction of remaining balance used per DCA tranche
SPOT_TAKE_PROFIT_PCT=0.05          # hard take-profit above entry
SPOT_TRAILING_STOP_PCT=0.05        # trailing stop drop from peak (only fires above profit floor)
SPOT_PROFIT_FLOOR_PCT=0.03         # minimum profit required before trailing stop can fire
SPOT_MIN_EXIT_PROFIT_PCT=0.02      # minimum profit before RSI sell signal can close position
SPOT_MIN_EXIT_PROFIT_PCT_SOLEUR=0.03  # per-pair override example
SPOT_RSI_PERIOD=14                 # RSI lookback; shorter = more signals
SPOT_RSI_PERIOD_ETHEUR=7
SPOT_RSI_PERIOD_SOLEUR=7
SPOT_RSI_PERIOD_ADAEUR=5
SPOT_RSI_OVERSOLD=30               # buy when RSI drops below this
SPOT_RSI_OVERSOLD_ADAEUR=33        # per-pair override
SPOT_RSI_OVERBOUGHT=75             # sell when RSI rises above this
SPOT_RSI_OVERBOUGHT_ETHEUR=65
SPOT_RSI_OVERBOUGHT_SOLEUR=80
SPOT_EMA_GAP_PCT=0.02              # price must be this % above EMA200 to allow a buy
SPOT_EMA_GAP_PCT_ADAEUR=0          # 0 = disable gap filter for this pair
SPOT_DAILY_EMA_FILTER=false        # true = also require price > daily EMA200
SPOT_TIME_STOP_DAYS=0              # close stalled positions after N days; 0 = disabled
SPOT_MAX_DRAWDOWN_PCT=0            # pause buys if portfolio drops >X% from peak; 0 = disabled
SPOT_STOP_CHECK_INTERVAL=60        # seconds between between-candle stop checks

# ── Shadow simulations ────────────────────────────────────────────────────────
# Run one or more parallel paper-trading strategies alongside the main engine.
# Each shadow gets its own state file (data/spot_state_shadow_<name>.json),
# its own balance, and feeds from the same candle ticks as the main bot.
# Only overridden params need to be listed — everything else inherits from Spot defaults.
#
# SPOT_SHADOW_PROFILES=AGGRESSIVE          # comma-separated profile names
# SPOT_SHADOW_AGGRESSIVE_RSI_OVERSOLD=25
# SPOT_SHADOW_AGGRESSIVE_TRAILING_STOP_PCT=0.07
# SPOT_SHADOW_AGGRESSIVE_PROFIT_FLOOR_PCT=0.02
# SPOT_SHADOW_AGGRESSIVE_BALANCE=200
#
# Supported overrides per profile (append to SPOT_SHADOW_<NAME>_):
#   RSI_OVERSOLD  RSI_OVERBOUGHT  RSI_PERIOD  TRAILING_STOP_PCT  PROFIT_FLOOR_PCT
#   TAKE_PROFIT_PCT  POSITION_SIZE_PCT  DCA_DROP_PCT  DCA_SIZE_PCT  DCA_MAX
#   DCA_STEP_PCT  EMA_GAP_PCT  MIN_EXIT_PROFIT_PCT  BALANCE

# ── Futures ───────────────────────────────────────────────────────────────────
FUTURES_ENABLED=true               # set to false to disable the futures engine
FUTURES_MODE=simulation            # simulation | live
FUTURES_TRADING_PAIRS=ETHUSDT,SOLUSDT
FUTURES_SIMULATION_BALANCE=200.0   # virtual USDT balance (simulation only)
FUTURES_LEVERAGE=2                 # notional = margin × leverage
FUTURES_MARGIN_TYPE=ISOLATED       # ISOLATED = loss capped per position | CROSSED = shared collateral
FUTURES_FEE=0.0005                 # 0.05% taker; funding cost adds on top for open longs
FUTURES_POSITION_SIZE_PCT=0.50     # fraction of balance posted as margin per position
FUTURES_DCA_DROP_PCT=0.99          # price drop from entry that triggers DCA (0.99 = disabled)
FUTURES_DCA_SIZE_PCT=0.75          # fraction of remaining balance used for DCA tranche
FUTURES_TAKE_PROFIT_PCT=0.05       # hard take-profit above entry (on notional)
FUTURES_TRAILING_STOP_PCT=0.05     # trailing stop drop from peak (only fires above profit floor)
FUTURES_PROFIT_FLOOR_PCT=0.01      # minimum profit before trailing stop can fire
FUTURES_MIN_EXIT_PROFIT_PCT=0.02   # minimum profit before signal exit can fire
FUTURES_RSI_PERIOD=7               # RSI lookback
FUTURES_RSI_OVERSOLD=25            # buy when RSI drops below this (RSI<25 outperforms RSI<35 over 2yr backtest)
FUTURES_RSI_OVERBOUGHT=75          # logged for reference; exits handled by trailing stop
FUTURES_EMA_GAP_PCT=0.02           # price must be this % above EMA200 to allow a long entry
FUTURES_MAX_DRAWDOWN_PCT=0         # pause longs if portfolio drops >X% from peak; 0 = disabled
FUTURES_STOP_CHECK_INTERVAL=60     # seconds between between-candle stop/funding checks

# ── Web dashboard ─────────────────────────────────────────────────────────────
WEB_HOST=0.0.0.0                   # 0.0.0.0 = LAN accessible
WEB_PORT=8888
